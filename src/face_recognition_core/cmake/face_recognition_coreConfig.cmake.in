@PACKAGE_INIT@

# -----------------------------------------------------------------------------
# face_recognition_core — face detection + recognition + gallery.
#
# Consumed by face_recognition_standalone / face_db_web / face_recognition_ros1
# / face_recognition_ros2 so that all of them link the SAME shared library
# instead of compiling the core sources into each binary.
#
# Usage:
#     find_package(face_recognition_core 1.0 REQUIRED)
#     target_link_libraries(<target> PRIVATE face_recognition_core::face_recognition_core)
#
# Point CMAKE_PREFIX_PATH at the project's install root (build.sh does).
# -----------------------------------------------------------------------------

include(CMakeFindDependencyMacro)

# OpenCV is a PUBLIC dependency, and the exported target references its libraries
# by target name (opencv_core, opencv_imgproc, ...). Those targets only exist
# after OpenCVConfig.cmake has run, so resolving it here is required for the
# package to be usable on its own.
find_dependency(OpenCV 4.5)

# Threads is referenced as a CMake target as well.
find_dependency(Threads)

# The remaining dependencies (vendored SQLite3, ONNX Runtime, libuuid) are
# recorded as absolute paths by design: this project pins the exact SQLite3 it
# was built against, so the path is part of the contract.

include("${CMAKE_CURRENT_LIST_DIR}/face_recognition_coreTargets.cmake")

check_required_components(face_recognition_core)
