// GENERATED by CMake from templates/index.html — do not edit.
//
// The admin UI normally loads templates/index.html at run time. It is also
// baked into the binary as a byte array so the page still renders when the
// executable is started from a directory that has no ./templates next to it.
// ---------------------------------------------------------------------------

#include <cstddef>
#include <string>

namespace face_db_web {
namespace embedded {

inline std::string index_html() {
    static const unsigned char kBytes[] = {
@FACE_DB_WEB_INDEX_HTML_BYTES@
    };
    return std::string(reinterpret_cast<const char*>(kBytes), sizeof(kBytes));
}

}  // namespace embedded
}  // namespace face_db_web
